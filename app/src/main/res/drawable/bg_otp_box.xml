<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused -->
    <item android:state_focused="true">
        <shape>
            <solid android:color="#FFFFFF"/>
            <stroke
                android:width="2dp"
                android:color="@color/purple_500"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape>
            <solid android:color="#FFFFFF"/>
            <stroke
                android:width="1.5dp"
                android:color="#CCCCCC"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

</selector>
