<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/profile_card_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_user_avatar"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_user_profile"
            app:civ_border_color="#E0E0E0"
            app:civ_border_width="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tv_user_name_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Alex Johnson"
            android:textColor="@color/text_black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@+id/iv_user_avatar"
            app:layout_constraintEnd_toStartOf="@+id/iv_arrow_profile"
            app:layout_constraintTop_toTopOf="@+id/iv_user_avatar"/>

        <TextView
            android:id="@+id/tv_user_email_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="alex@example.com"
            android:textColor="@color/text_gray"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@+id/iv_user_avatar"
            app:layout_constraintEnd_toStartOf="@+id/iv_arrow_profile"
            app:layout_constraintTop_toBottomOf="@+id/tv_user_name_settings"/>

        <ImageView
            android:id="@+id/iv_arrow_profile"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/text_gray"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
