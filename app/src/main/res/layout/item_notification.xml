<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <ImageView
        android:id="@+id/iv_notification_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_notification_icon"
        android:padding="8dp"
        android:src="@drawable/ic_ai_suggestion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_notification_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="AI Suggestion Available"
        android:textColor="@color/text_black"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/iv_unread_dot"
        app:layout_constraintStart_toEndOf="@+id/iv_notification_icon"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_notification_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="3 tasks can be optimized for better productivity"
        android:textColor="@color/text_gray"
        app:layout_constraintEnd_toEndOf="@+id/tv_notification_title"
        app:layout_constraintStart_toEndOf="@+id/iv_notification_icon"
        app:layout_constraintTop_toBottomOf="@+id/tv_notification_title" />

    <TextView
        android:id="@+id/tv_notification_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:text="2 min ago"
        android:textColor="@color/text_gray"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@+id/iv_notification_icon"
        app:layout_constraintTop_toBottomOf="@+id/tv_notification_subtitle" />

    <ImageView
        android:id="@+id/iv_unread_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/bg_unread_dot"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
