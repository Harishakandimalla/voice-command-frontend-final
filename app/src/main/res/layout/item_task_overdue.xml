<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_task_overdue"
    android:padding="16dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp">

    <ImageView
        android:id="@+id/iv_task_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_overdue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/tv_task_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Submit expense report"
        android:textColor="#000000"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/iv_task_icon"
        app:layout_constraintEnd_toStartOf="@+id/tv_task_priority"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="12dp"/>

    <TextView
        android:id="@+id/tv_task_overdue_days"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2 days overdue"
        android:textColor="#F44336"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/iv_task_icon"
        app:layout_constraintTop_toBottomOf="@id/tv_task_title"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/tv_task_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Work"
        android:textSize="12sp"
        android:background="#EFEFEF"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        app:layout_constraintStart_toEndOf="@id/tv_task_overdue_days"
        app:layout_constraintTop_toTopOf="@id/tv_task_overdue_days"
        app:layout_constraintBottom_toBottomOf="@id/tv_task_overdue_days"
        android:layout_marginStart="8dp"/>

    <TextView
        android:id="@+id/tv_task_priority"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="High"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="#FFF0E1"
        android:textColor="#FFA500"
        android:padding="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
