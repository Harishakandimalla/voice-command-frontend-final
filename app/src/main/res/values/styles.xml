<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="Theme.VoiceCommandAIApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Custom App Attributes -->
        <item name="android:windowBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

    <style name="Theme.VoiceCommandAIApp.Splash" parent="Theme.VoiceCommandAIApp">
        <item name="android:windowBackground">@drawable/bg_home_header</item>
    </style>

    <!-- Accent Color Themes -->
    <style name="Theme.VoiceCommandAIApp.Purple" parent="Theme.VoiceCommandAIApp">  <item name="colorPrimary">@color/accent_purple</item></style>
    <style name="Theme.VoiceCommandAIApp.Blue" parent="Theme.VoiceCommandAIApp">   <item name="colorPrimary">@color/accent_blue</item></style>
    <style name="Theme.VoiceCommandAIApp.Green" parent="Theme.VoiceCommandAIApp">  <item name="colorPrimary">@color/accent_green</item></style>
    <style name="Theme.VoiceCommandAIApp.Pink" parent="Theme.VoiceCommandAIApp">   <item name="colorPrimary">@color/accent_pink</item></style>
    <style name="Theme.VoiceCommandAIApp.Orange" parent="Theme.VoiceCommandAIApp"> <item name="colorPrimary">@color/accent_orange</item></style>

    <!-- Other Widget Styles -->
    <style name="CommandBubble">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_command_bubble</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textColor">#444444</item>
        <item name="android:textSize">13sp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="OtpBox">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/bg_otp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">18sp</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:textColor">@android:color/black</item>
    </style>
    <style name="HomeSectionTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#000000</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">16dp</item>
    </style>

    <style name="Widget.App.Chip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background_color</item>
        <item name="android:textColor">@color/chip_text_color</item>
    </style>

    <style name="CustomChipStyle" parent="Widget.App.Chip">
        <!-- You can add custom attributes here if you want to override the base style -->
    </style>
</resources>
